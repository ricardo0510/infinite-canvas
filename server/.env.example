# HTTP
PORT=8790
PUBLIC_BASE_URL=http://localhost:8790
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# 单用户引导令牌；多用户请使用数据库 token（npm run token:create）
# 不配置 API_TOKEN 且 DEV_ALLOW_ANONYMOUS=true 时允许匿名，仅限本地开发
API_TOKEN=
DEV_ALLOW_ANONYMOUS=true

# 上传（本地开发）
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520

# 管理端（AdminJS + Bull Board）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_COOKIE_SECRET=change-me-to-a-long-random-string

# 任务
TASK_TIMEOUT_MS=1800000

# BYOK：用户 API Key 加密主密钥（生产请用 KMS/Vault 注入，勿提交真实值）
KEY_ENCRYPTION_SECRET=

# PostgreSQL / Redis（server/docker-compose.yml）
DATABASE_URL=postgresql://canvas:canvas@localhost:5432/canvas
REDIS_URL=redis://localhost:6379
WORKER_DISABLED=false
WORKER_CONCURRENCY=4

ADMIN_PORT=8791
