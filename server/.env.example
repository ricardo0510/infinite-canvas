# HTTP
PORT=8790
PUBLIC_BASE_URL=http://localhost:8790
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# 开发模式：不配置 API_TOKEN 时允许匿名；生产必须配置
API_TOKEN=
DEV_ALLOW_ANONYMOUS=true

# 上传（本地开发）
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520

# 任务
TASK_TIMEOUT_MS=1800000

# 后续切换到 PostgreSQL / Redis 时使用
# DATABASE_URL=postgresql://canvas:canvas@localhost:5432/canvas
# REDIS_URL=redis://localhost:6379
